    if (typeof jQuery === 'undefined' || typeof jQuery.fn.sliderPro === 'undefined') {
        return setTimeout(waitForSliderPro, 50);
    }
    jQuery('.jet-slider').each(function() {
        var $slider = jQuery(this);
        if ($slider.data('sp-initialized')) return;
        $slider.data('sp-initialized', true);

        var rawSettings = $slider.attr('data-settings') || '{}';
        // data-settings uses HTML entities — decode them
        var decoded = rawSettings
